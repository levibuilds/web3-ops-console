{
  "name": "web3-ops-console",
  "version": "0.1.0",
  "description": "A Web3 exchange operations intelligence console for announcements, campaigns, search, comparison and operations briefs.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/levibuilds/web3-ops-console.git"
  },
  "keywords": [
    "web3",
    "crypto-exchange",
    "operations",
    "ai",
    "dashboard",
    "sqlite",
    "nodejs"
  ],
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "NODE_ENV=production node src/server.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js && node --check src/core.mjs",
    "test": "node --test",
    "build:showcase": "node scripts/build-showcase.mjs",
    "refresh-snapshot": "node scripts/refresh-snapshot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
